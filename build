#!/bin/bash
# bash (not plain sh) so that "set -o pipefail" works and a failed make
# is not hidden by "| tee".

set -e -x -o pipefail

# Kernel Source
KERNEL_SOURCE="https://github.com/AntonIXO/SailfishOS-Miatoll-Kernel"
KERNEL_BRANCH="sailfish"

# Defconfig NAME (not a directory), relative to arch/arm64/configs/
# e.g. "miatoll_defconfig" or "vendor/miatoll_defconfig".
# Leave empty to auto-detect a file containing "miatoll" or "sailfish".
KERNEL_DEFCONFIG=""

# Prebuilt Clang Toolchain (AOSP)
CLANG_URL="https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/refs/heads/master-kernel-build-2021/clang-r416183b.tar.gz"

# Prebuilt GCC Utilities (AOSP)
GCC_x64="https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9"
GCC_x32="https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9"
GCC_BRANCH="master-kernel-build-2021"

# Setup make Command
make_fun() {
	make O=out ARCH=arm64 CC=clang HOSTCC=clang \
		CLANG_TRIPLE=aarch64-linux-gnu- \
		CROSS_COMPILE=aarch64-linux-androidkernel- \
		CROSS_COMPILE_ARM32=arm-linux-androideabi- "$@"
}

# Work Path
WORK="${HOME}/work"

# Kernel Folder Name
KERNEL="myKernel"

# Kernel Source Path
KERNEL_SRC="${WORK}/${KERNEL}"

# Prepare Directory
mkdir -p "${WORK}"
cd "${WORK}" || exit 1

# Cloning all the Necessary files
# (using "if" instead of "[ ] &&" so set -e does not abort when a dir exists)
if [ ! -d clang ]; then
	mkdir clang
	# -f: fail on HTTP errors instead of saving an error page
	if ! curl -fL --retry 3 "${CLANG_URL}" -o clang.tgz || ! tar -xzf clang.tgz -C clang; then
		rm -rf clang clang.tgz
		echo "Failed to download/extract clang. Check CLANG_URL and the branch name."
		exit 1
	fi
	rm -f clang.tgz
fi

if [ ! -d x64 ]; then
	git clone --depth=1 -b "${GCC_BRANCH}" "${GCC_x64}" ./x64
fi

if [ ! -d x32 ]; then
	git clone --depth=1 -b "${GCC_BRANCH}" "${GCC_x32}" ./x32
fi

if [ ! -d "${KERNEL}" ]; then
	git clone --depth=1 -b "${KERNEL_BRANCH}" "${KERNEL_SOURCE}" "${KERNEL}"
fi

# Setting Toolchain Path (appended to the existing PATH so system tools
# like nproc, tee, dtc, bc, python3, flex and bison are still found)
PATH="${WORK}/clang/bin:${WORK}/x64/bin:${WORK}/x32/bin:${PATH}"
export PATH

# Enter Kernel root directory
cd "${KERNEL_SRC}" || exit 1

# Resolve defconfig
if [ -z "${KERNEL_DEFCONFIG}" ]; then
	KERNEL_DEFCONFIG="$(cd arch/arm64/configs && find . -type f \( -iname '*miatoll*' -o -iname '*sailfish*' \) | sed 's|^\./||' | sort | head -n1)"
fi

if [ -z "${KERNEL_DEFCONFIG}" ] || [ ! -f "arch/arm64/configs/${KERNEL_DEFCONFIG}" ]; then
	echo "Defconfig not found. Set KERNEL_DEFCONFIG to one of:"
	(cd arch/arm64/configs && find . -type f -name '*defconfig' | sed 's|^\./||' | sort)
	exit 1
fi

echo "Using defconfig: ${KERNEL_DEFCONFIG}"

# KernelSU - Disable if not building one.
# Note: this runs a remote script, only enable it if you trust it.
# curl -LSs "https://raw.githubusercontent.com/tiann/KernelSU/main/kernel/setup.sh" | bash -

# Start Compiling Kernel
make_fun "${KERNEL_DEFCONFIG}"
make_fun -j"$(nproc --all)" 2>&1 | tee build.log
